{
  "name": "hiennvauto",
  "version": "1.0.0",
  "description": "HienNVAuto - Antidetect Browser Manager",
  "main": "./out/main/index.js",
  "author": "HienNV",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || exit 0",
    "dist": "electron-vite build && electron-builder --win && powershell -ExecutionPolicy Bypass -File scripts/set-exe-icon.ps1"
  },
  "build": {
    "appId": "com.hiennv.hiennvauto",
    "productName": "HienNVAuto",
    "directories": {
      "output": "release"
    },
    "_filesComment": [
      "patchright + patchright-core (~18MB) are hard dependencies of @proxyshard/shardx",
      "and CANNOT be excluded: dist/index.js line 3 is a TOP-LEVEL `import { chromium }",
      "from \"patchright\"`, not a lazy import inside session(). Verified by temporarily",
      "removing each package and running `import('@proxyshard/shardx')`: both fail with",
      "ERR_MODULE_NOT_FOUND, which would kill the whole engine. Only their TypeScript",
      "definitions and docs are dropped below (~2.3MB), which the runtime never reads."
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/patchright/types/**",
      "!**/node_modules/patchright-core/types/**",
      "!**/node_modules/patchright*/*.d.ts",
      "!**/node_modules/patchright*/README.md",
      "!**/node_modules/patchright*/test.{js,mjs}"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@proxyshard/shardx": "0.1.11",
    "better-sqlite3": "^11.3.0",
    "country-flag-icons": "^1.6.20",
    "franc-min": "^6.2.0",
    "https-proxy-agent": "^9.0.0",
    "puppeteer-core": "^23.6.0",
    "socks-proxy-agent": "^10.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@iconify-json/lucide": "^1.2.120",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
